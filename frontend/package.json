{
  "name": "stocgain-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "next build",
    "start": "next start --port 3050",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api/schema.ts"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-table": "^8",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "latest",
    "openapi-typescript": "^7",
    "postcss": "latest",
    "prettier": "latest",
    "tailwindcss": "^4",
    "tw-animate-css": "latest",
    "typescript": "^5",
    "vitest": "latest"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "@tailwindcss/oxide": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "type": "module"
}
